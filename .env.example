# API (apps/api)
PORT=4300

# Translate pipeline backend: "local" (default, our license-clean SLM) or "anthropic" (premium)
TRANSLATE_BACKEND=local
# Self-trained Apache-2.0 SLM (packages/slm), served over an OpenAI-compatible API.
# Default targets LM Studio; point at a vLLM server for production (same shape).
SLM_BASE_URL=http://localhost:1338/v1
SLM_MODEL=mynichi-translate

# Only needed when TRANSLATE_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# App (apps/native) - EXPO_PUBLIC_* are bundled into the client.
# Defaults to http://localhost:4300 in dev builds when unset.
EXPO_PUBLIC_API_URL=
