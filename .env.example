# API (apps/api)
PORT=4300

# Translate pipeline backend:
#   "ollama"   (default) two-stage local SLMs via Ollama
#   "lmstudio" self-trained student SLM via LM Studio (see packages/slm)
#   "anthropic" premium cloud
TRANSLATE_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
TRANSLATE_MODEL_TRANSLATE=mitmul/plamo-2-translate:Q4_K_M
TRANSLATE_MODEL_PRACTICAL=hf.co/mradermacher/shisa-v2.1-qwen3-8b-GGUF:Q5_K_M

# Only used when TRANSLATE_BACKEND=lmstudio
LMSTUDIO_URL=http://127.0.0.1:1338/v1
TRANSLATE_MODEL_STUDENT=mynichi-slm

# Only needed when TRANSLATE_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# App (apps/native) - EXPO_PUBLIC_* are bundled into the client.
# Defaults to http://localhost:4300 in dev builds when unset.
EXPO_PUBLIC_API_URL=
